{
  "name": "@huydepzai2810/browzy-host",
  "version": "1.0.0",
  "description": "MCP server, native messaging host, and install CLI for Browzy in Chrome",
  "type": "module",
  "bin": {
    "browzy": "bin/browzy.js"
  },
  "files": [
    ".claude-plugin/",
    "skills/",
    "npm-shrinkwrap.json",
    "bin/",
    "agent/",
    "codemode/",
    "endpoint.js",
    "mcp-server.js",
    "native-host.js",
    "parent-watch.js",
    "tool-definitions.js",
    "tool-runtime.js",
    "!codemode/worker/node_modules/**",
    "!codemode/worker/.wrangler/**",
    "!codemode/test-codemode.js",
    "!codemode/test-hybrid.js",
    "!agent/settings/testing/**",
    "!agent/spike/**"
  ],
  "scripts": {
    "test": "node test/endpoint.test.mjs && node test/parent-watch.test.mjs && node test/ownership.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.0"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": {
      "zod": "$zod"
    },
    "@modelcontextprotocol/sdk": {
      "zod": "$zod"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
